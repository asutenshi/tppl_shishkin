{
  // Демо 3: тот же клиент, но сервер наш (mini/server.py) и файлы любого текста
  "lspDemo.serverCommand": ["sh", "-c", "exec ../../.venv/bin/python server.py 2>> server.log"],
  "lspDemo.languages": ["plaintext"],
  "lspDemo.trace.server": "verbose",

  "workbench.colorTheme": "Light Modern",
